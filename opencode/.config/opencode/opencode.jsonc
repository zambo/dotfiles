{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"enabled_providers": [
		"fuel_ix_completions",
		"fuel_ix_responses",
		"anthropic",
		"github-copilot"
	],
	"plugin": ["opencode-with-claude"],
	"username": "zambo",
	"autoupdate": true,
	"provider": {
		"fuel_ix_completions": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Fuel iX (completions)",
			"options": {
				"baseURL": "https://api.fuelix.ai/v1",
				"apiKey": "{env:FUELIX_API_KEY}"
			},
			"models": {
				"claude-sonnet-5-5": {
					"name": "Claude Sonnet 5.5"
				},
				"claude-haiku-4-5": {
					"name": "Claude Haiku 4.5"
				},
				"gemini-3.1-pro": {
					"name": "Gemini 3.1 Pro"
				},
				"gemini-3.1-pro-preview": {
					"name": "Gemini 3.1 Pro Preview"
				},
				"gemini-3.1-flash-image": {
					"name": "Gemini 3.1 Flash Image"
				},
				"gemini-3.1-flash-lite": {
					"name": "Gemini 3.1 Flash Lite"
				}
			}
		},
		"fuel_ix_responses": {
			"npm": "@ai-sdk/openai",
			"name": "Fuel iX (responses)",
			"options": {
				"baseURL": "https://api.fuelix.ai/v1",
				"apiKey": "{env:FUELIX_API_KEY}"
			},
			"models": {
				"claude-opus-5-5": {
					"name": "Claude Opus 5.5"
				},
				"gpt-5.6-luna": {
					"name": "GPT 5.6 Luna"
				},
				"gpt-5.6-terra": {
					"name": "GPT 5.6 Terra"
				}
			}
		},
		"anthropic": {
			"options": {
				"baseURL": "http://127.0.0.1:3456",
				"apiKey": "dummy"
			}
		}
	},
	"permission": {
		"external_directory": {
			"$HOME/_/notes/**": "allow",
			"$HOME/_/handoffs/**": "allow",
			"/tmp/**": "allow"
		}
	},
	"mcp": {
		// "figma": {
		// 	"url": "http://127.0.0.1:3845/mcp",
		// 	"type": "remote"
		// },
		// "mobile-mcp": {
		// 	"type": "local",
		// 	"command": ["npx", "@mobilenext/mobile-mcp@latest"],
		// 	"enabled": true
		// }
	}
}
